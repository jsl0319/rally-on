generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  WITHDRAWN
}

enum UserRole {
  MEMBER
  INTERNAL_REVIEWER
}

enum ExperienceRange {
  UNDER_3_MONTHS
  MONTHS_3_TO_6
  MONTHS_6_TO_12
  YEARS_1_TO_2
  YEARS_2_PLUS
}

enum RallyLevel {
  STARTING
  SHORT_RALLY
  COMFORTABLE_RALLY
  STANDARD_RALLY
}

enum GameExperience {
  NONE
  KNOWS_RULES
  PLAYED_FEW
  CAN_PLAY
}

enum PlayPurpose {
  CASUAL_HIT
  RALLY_PRACTICE
  STROKE_PRACTICE
  GAME_INTRO
  GAME
}

enum RegionType {
  CITY
  DISTRICT
}

enum CourtSource {
  EXTERNAL_RESERVED
  COURT_TBD
  PARTNER_COURT
}

enum PartnerPreference {
  COMPLETE_BEGINNER_WELCOME
  SIMILAR_LEVEL
  GAME_CAPABLE
}

enum MatchStatus {
  OPEN
  CLOSED
  COMPLETED
  EXPIRED
  CANCELLED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
  CANCELLED
}

enum MatchConversationStatus {
  OPEN
  READ_ONLY
  ARCHIVED
}

enum MatchConversationMemberRole {
  HOST
  PARTICIPANT
}

enum MatchChatMessageType {
  USER
  SYSTEM
}

enum MatchChatMessageVisibility {
  VISIBLE
  HIDDEN
}

enum MatchChatImageUploadStatus {
  PENDING
  ATTACHED
  CLEANUP_PENDING
  DELETED
}

enum MatchChatReportReason {
  HARASSMENT
  SEXUAL_OR_HATEFUL_CONTENT
  PERSONAL_INFORMATION
  SPAM_OR_FRAUD
  OTHER
}

enum MatchChatReportStatus {
  OPEN
  RESOLVED
}

enum MatchChatModerationActionType {
  NO_ACTION
  HIDE_MESSAGE
  SUSPEND_SENDING
  SET_READ_ONLY
}

enum CourtImageUploadStatus {
  PENDING
  ATTACHED
  CLEANUP_PENDING
  DELETED
}

enum CourtImageStatus {
  PENDING
  ATTACHED
  REPLACED
  CLEANUP_PENDING
  DELETED
}

enum CourtStatus {
  ACTIVE
  INACTIVE
}

enum CourtSlotVisibility {
  PRIVATE
  PUBLIC
}

enum CourtSlotStatus {
  DRAFT
  AVAILABLE
  ALLOCATED
  ENDED
  BLOCKED
  CANCELLED
}

enum SlotStatusChangeActor {
  OPERATOR
  SESSION_HOST
  SYSTEM
  ADMIN
}

enum CourtSupplyIncidentCode {
  SCHEDULE_UNAVAILABLE
  FACILITY_CLOSED
  SAFETY_RISK
  NATURAL_DISASTER
  INFORMATION_REVIEW
}

enum CourtSupplyIncidentImpact {
  NONE
  CANCEL_MATCH
}

enum CourtSupplyIncidentStatus {
  REQUESTED
  WITHDRAWN
  REVIEWED
  REJECTED
}

enum OperatorSupplyRestrictionSource {
  AUTOMATED
  ADMIN
}

enum OperatorApplicationStatus {
  DRAFT
  VERIFYING
  DRAFT_ACCESS_GRANTED
  REVIEW_REQUIRED
  UNDER_REVIEW
  CHANGES_REQUESTED
  PUBLISH_APPROVED
  REJECTED
  SUSPENDED
}

enum OperatorApplicationEvidenceUploadStatus {
  PENDING
  ATTACHED
  REPLACED
  CLEANUP_PENDING
  DELETED
}

enum OperatorApplicationReviewDecision {
  APPROVE_PUBLISH
  REQUEST_CHANGES
  REJECT
  SUSPEND_PUBLISH
}

enum OperatorApplicationReviewReasonCode {
  MANUAL_VERIFIED
  INFORMATION_INCOMPLETE
  BUSINESS_UNVERIFIED
  VENUE_UNVERIFIED
  OPERATING_AUTHORITY_UNCONFIRMED
  DUPLICATE_VENUE
  SAFETY_REVIEW
  VENUE_CLOSED
}

enum BusinessVerificationStatus {
  PENDING
  VERIFIED
  MISMATCH
  UNAVAILABLE
}

enum VenueVerificationStatus {
  PENDING
  MATCHED
  REVIEW_REQUIRED
  UNAVAILABLE
}

enum VerificationAttemptKind {
  BUSINESS
  VENUE
}

enum VerificationAttemptResult {
  VERIFIED
  MISMATCH
  UNAVAILABLE
  REVIEW_REQUIRED
  PENDING
}

model User {
  id                    String     @id @default(uuid()) @db.Uuid
  nickname              String     @unique @db.VarChar(12)
  status                UserStatus @default(ACTIVE)
  role                  UserRole   @default(MEMBER)
  nicknameConfirmedAt   DateTime?  @map("nickname_confirmed_at") @db.Timestamptz(6)
  onboardingCompletedAt DateTime?  @map("onboarding_completed_at") @db.Timestamptz(6)
  withdrawnAt           DateTime?  @map("withdrawn_at") @db.Timestamptz(6)
  matchNotificationsEnabled Boolean @default(true) @map("match_notifications_enabled")
  kakaoProfileImageUrl    String?   @map("kakao_profile_image_url") @db.VarChar(500)
  profileImageObjectRef   String?   @map("profile_image_object_ref") @db.VarChar(500)
  profileImageContentType String?   @map("profile_image_content_type") @db.VarChar(40)
  profileImageUpdatedAt   DateTime? @map("profile_image_updated_at") @db.Timestamptz(6)
  createdAt             DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  authAccounts         AuthAccount[]
  tennisProfile        TennisProfile?
  apiRateLimit         ApiRateLimit?
  hostedMatches        Match[]                    @relation("MatchHost")
  matchApplications    MatchApplication[]
  courtImageUploads    CourtImageUpload[]
  courtImages          CourtImage[]
  operatorApplications CourtOperatorApplication[] @relation("OperatorApplicationApplicant")
  operatorApplicationEvidenceUploads OperatorApplicationEvidenceUpload[] @relation("OperatorApplicationEvidenceUploadOwner")
  operatorApplicationReviews OperatorApplicationReview[] @relation("OperatorApplicationReviewer")
  courtStatusChanges CourtStatusChange[] @relation("CourtStatusChangeReviewer")
  courtSlotStatusHistories CourtSlotStatusHistory[] @relation("CourtSlotStatusActor")
  supplyNoticeRecipients MatchSupplyNoticeRecipient[] @relation("MatchSupplyNoticeRecipientUser")
  clearedSupplyRestrictions OperatorSupplyRestriction[] @relation("OperatorSupplyRestrictionClearedBy")
  matchConversationMemberships MatchConversationMember[]
  sentMatchChatMessages MatchChatMessage[] @relation("MatchChatMessageSender")
  matchChatImageUploads MatchChatImageUpload[] @relation("MatchChatImageUploadOwner")
  matchChatReports MatchChatReport[] @relation("MatchChatReportReporter")
  matchChatModerationActions MatchChatModerationAction[] @relation("MatchChatModerationReviewer")
  notifications Notification[]
  supportInquiries SupportInquiry[]

  @@map("users")
}

model AuthAccount {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  provider          String   @db.VarChar(30)
  providerAccountId String   @map("provider_account_id") @db.VarChar(191)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("auth_accounts")
}

enum ProfileGender {
  MALE
  FEMALE
}

model TennisProfile {
  gender              ProfileGender?
  id                  String          @id @default(uuid()) @db.Uuid
  userId              String          @unique @map("user_id") @db.Uuid
  experienceRange     ExperienceRange @map("experience_range")
  rallyLevel          RallyLevel      @map("rally_level")
  gameExperience      GameExperience  @map("game_experience")
  skillLabel          String?         @map("skill_label") @db.VarChar(30)
  version             Int             @default(1)
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  purposes TennisProfilePurpose[]

  @@map("tennis_profiles")
}

model Region {
  code       String     @id @db.VarChar(30)
  parentCode String?    @map("parent_code") @db.VarChar(30)
  name       String     @db.VarChar(50)
  shortName  String?    @map("short_name") @db.VarChar(30)
  type       RegionType
  active     Boolean    @default(true)

  parent   Region?  @relation("RegionHierarchy", fields: [parentCode], references: [code], onDelete: Restrict)
  children Region[] @relation("RegionHierarchy")
  courts   Court[]

  @@unique([parentCode, name])
  @@index([parentCode, active])
  @@map("regions")
}

model TennisProfilePurpose {
  tennisProfileId String      @map("tennis_profile_id") @db.Uuid
  purpose         PlayPurpose

  tennisProfile TennisProfile @relation(fields: [tennisProfileId], references: [id], onDelete: Cascade)

  @@id([tennisProfileId, purpose])
  @@map("tennis_profile_purposes")
}

model ApiRateLimit {
  userId          String   @id @map("user_id") @db.Uuid
  windowStartedAt DateTime @map("window_started_at") @db.Timestamptz(6)
  requestCount    Int      @default(0) @map("request_count")
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_rate_limits")
}

enum NotificationType {
  APPLICATION_RECEIVED
  APPLICATION_ACCEPTED
  APPLICATION_REJECTED
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String           @db.VarChar(80)
  body      String           @db.VarChar(200)
  href      String?          @db.VarChar(255)
  readAt    DateTime?        @map("read_at") @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
  @@map("notifications")
}

model Announcement {
  id          String   @id @default(uuid()) @db.Uuid
  title       String   @db.VarChar(120)
  body        String   @db.VarChar(2000)
  publishedAt DateTime @default(now()) @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([publishedAt(sort: Desc)])
  @@map("announcements")
}

enum SupportInquiryStatus {
  OPEN
  ANSWERED
}

model SupportInquiry {
  id        String               @id @default(uuid()) @db.Uuid
  userId    String               @map("user_id") @db.Uuid
  message   String               @db.VarChar(1000)
  status    SupportInquiryStatus @default(OPEN)
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt(sort: Desc)])
  @@map("support_inquiries")
}

enum MatchGameType {
  MIXED_DOUBLES
  MENS_DOUBLES
  WOMENS_DOUBLES
  SINGLES
  RALLY
  OTHER
}

model Match {
  id                   String            @id @default(uuid()) @db.Uuid
  hostUserId           String            @map("host_user_id") @db.Uuid
  clientRequestId      String            @map("client_request_id") @db.Uuid
  title                String            @db.VarChar(80)
  startsAt             DateTime          @map("starts_at") @db.Timestamptz(6)
  endsAt               DateTime          @map("ends_at") @db.Timestamptz(6)
  courtSource          CourtSource       @default(EXTERNAL_RESERVED) @map("court_source")
  externalCourtName    String?           @map("external_court_name") @db.VarChar(100)
  externalCourtAddress String?           @map("external_court_address") @db.VarChar(255)
  externalCourtNumber  String?           @map("external_court_number") @db.VarChar(50)
  externalCourtImageUploadId String?     @unique @map("external_court_image_upload_id") @db.Uuid
  courtSlotId            String?           @unique @map("court_slot_id") @db.Uuid
  recruitCount         Int               @map("recruit_count")
  partnerPreference    PartnerPreference @map("partner_preference")
  totalCourtFeeKrw     Int?              @map("total_court_fee_krw")
  additionalCostNote   String?           @map("additional_cost_note") @db.VarChar(200)
  introduction         String?           @db.VarChar(300)
  maleRecruitCount     Int?              @map("male_recruit_count")
  femaleRecruitCount   Int?              @map("female_recruit_count")
  gameType             MatchGameType?    @map("game_type")
  settlementBank       String?           @map("settlement_bank") @db.VarChar(50)
  settlementAccountNumber String?        @map("settlement_account_number") @db.VarChar(40)
  settlementAccountHolder String?        @map("settlement_account_holder") @db.VarChar(50)
  status               MatchStatus       @default(OPEN)
  version              Int               @default(1)
  closedAt             DateTime?         @map("closed_at") @db.Timestamptz(6)
  completedAt          DateTime?         @map("completed_at") @db.Timestamptz(6)
  expiredAt            DateTime?         @map("expired_at") @db.Timestamptz(6)
  cancelledAt          DateTime?         @map("cancelled_at") @db.Timestamptz(6)
  cancellationReason   String?           @map("cancellation_reason") @db.VarChar(200)
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  host         User               @relation("MatchHost", fields: [hostUserId], references: [id], onDelete: Restrict)
  purposes     MatchPurpose[]
  applications MatchApplication[]
  externalCourtImageUpload CourtImageUpload? @relation("ExternalCourtImage", fields: [externalCourtImageUploadId], references: [id], onDelete: Restrict)
  courtSlot    CourtSlot?          @relation(fields: [courtSlotId], references: [id], onDelete: Restrict)
  supplyIncidents CourtSupplyIncident[]
  supplyNoticeRecipients MatchSupplyNoticeRecipient[]
  conversation MatchConversation?

  @@unique([hostUserId, clientRequestId])
  @@index([status, startsAt])
  @@index([hostUserId, status, startsAt])
  @@map("matches")
}

model CourtImageUpload {
  id               String                 @id @default(uuid()) @db.Uuid
  ownerUserId      String                 @map("owner_user_id") @db.Uuid
  privateObjectRef String                 @unique @map("private_object_ref") @db.VarChar(500)
  contentType      String                 @map("content_type") @db.VarChar(100)
  byteSize         Int                    @map("byte_size")
  status           CourtImageUploadStatus @default(PENDING)
  attachedAt       DateTime?              @map("attached_at") @db.Timestamptz(6)
  cleanupClaimedAt DateTime?              @map("cleanup_claimed_at") @db.Timestamptz(6)
  deletedAt        DateTime?              @map("deleted_at") @db.Timestamptz(6)
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner         User   @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  attachedMatch Match? @relation("ExternalCourtImage")

  @@index([ownerUserId, status, createdAt])
  @@index([status, createdAt])
  @@map("court_image_uploads")
}

model MatchPurpose {
  matchId String      @map("match_id") @db.Uuid
  purpose PlayPurpose

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@id([matchId, purpose])
  @@index([purpose, matchId])
  @@map("match_purposes")
}

model MatchApplication {
  applicantGender        ProfileGender?    @map("applicant_gender")
  id                     String            @id @default(uuid()) @db.Uuid
  matchId                String            @map("match_id") @db.Uuid
  applicantUserId        String            @map("applicant_user_id") @db.Uuid
  status                 ApplicationStatus @default(PENDING)
  message                String?           @db.VarChar(200)
  profileSnapshot        Json              @map("profile_snapshot") @db.JsonB
  profileSnapshotVersion Int               @default(1) @map("profile_snapshot_version")
  decidedAt              DateTime?         @map("decided_at") @db.Timestamptz(6)
  withdrawnAt            DateTime?         @map("withdrawn_at") @db.Timestamptz(6)
  cancelledAt            DateTime?         @map("cancelled_at") @db.Timestamptz(6)
  createdAt              DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  match         Match @relation(fields: [matchId], references: [id], onDelete: Restrict)
  applicantUser User  @relation(fields: [applicantUserId], references: [id], onDelete: Restrict)

  @@unique([matchId, applicantUserId])
  @@index([matchId, status, createdAt])
  @@index([applicantUserId, status, createdAt(sort: Desc)])
  @@map("match_applications")
}

model MatchConversation {
  id          String                  @id @default(uuid()) @db.Uuid
  matchId     String                  @unique @map("match_id") @db.Uuid
  status      MatchConversationStatus @default(OPEN)
  readOnlyAt  DateTime?               @map("read_only_at") @db.Timestamptz(6)
  archiveAt   DateTime?               @map("archive_at") @db.Timestamptz(6)
  createdAt   DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  match    Match                     @relation(fields: [matchId], references: [id], onDelete: Restrict)
  members  MatchConversationMember[]
  messages MatchChatMessage[]
  imageUploads MatchChatImageUpload[]

  @@index([status, archiveAt])
  @@map("match_conversations")
}

model MatchConversationMember {
  id                 String                      @id @default(uuid()) @db.Uuid
  conversationId     String                      @map("conversation_id") @db.Uuid
  userId             String                      @map("user_id") @db.Uuid
  role               MatchConversationMemberRole
  joinedAt           DateTime                    @default(now()) @map("joined_at") @db.Timestamptz(6)
  sendingSuspendedAt DateTime?                   @map("sending_suspended_at") @db.Timestamptz(6)
  lastReadMessageId  String?                     @map("last_read_message_id") @db.Uuid
  updatedAt          DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)

  conversation MatchConversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  user         User              @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([conversationId, userId])
  @@index([userId, updatedAt])
  @@map("match_conversation_members")
}

model MatchChatMessage {
  id              String                     @id @default(uuid()) @db.Uuid
  conversationId  String                     @map("conversation_id") @db.Uuid
  senderUserId    String?                    @map("sender_user_id") @db.Uuid
  type            MatchChatMessageType       @default(USER)
  body            String                     @db.VarChar(500)
  visibility      MatchChatMessageVisibility @default(VISIBLE)
  clientRequestId String?                    @map("client_request_id") @db.Uuid
  createdAt       DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation MatchConversation   @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  sender       User?               @relation("MatchChatMessageSender", fields: [senderUserId], references: [id], onDelete: Restrict)
  imageUploads MatchChatImageUpload[]
  reports      MatchChatReport[]

  @@unique([senderUserId, clientRequestId])
  @@index([conversationId, createdAt, id])
  @@map("match_chat_messages")
}

model MatchChatImageUpload {
  id               String                     @id @default(uuid()) @db.Uuid
  conversationId   String                     @map("conversation_id") @db.Uuid
  ownerUserId      String                     @map("owner_user_id") @db.Uuid
  messageId        String?                    @map("message_id") @db.Uuid
  position         Int?
  privateObjectRef String                     @unique @map("private_object_ref") @db.VarChar(500)
  contentType      String                     @map("content_type") @db.VarChar(100)
  byteSize         Int                        @map("byte_size")
  status           MatchChatImageUploadStatus @default(PENDING)
  attachedAt       DateTime?                  @map("attached_at") @db.Timestamptz(6)
  cleanupClaimedAt DateTime?                  @map("cleanup_claimed_at") @db.Timestamptz(6)
  deletedAt        DateTime?                  @map("deleted_at") @db.Timestamptz(6)
  createdAt        DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)

  conversation MatchConversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  owner        User              @relation("MatchChatImageUploadOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  message      MatchChatMessage? @relation(fields: [messageId], references: [id], onDelete: Restrict)

  @@unique([messageId, position])
  @@index([conversationId, ownerUserId, status, createdAt])
  @@index([status, createdAt])
  @@map("match_chat_image_uploads")
}

model MatchChatReport {
  id             String                @id @default(uuid()) @db.Uuid
  messageId      String                @map("message_id") @db.Uuid
  reporterUserId String                @map("reporter_user_id") @db.Uuid
  reason         MatchChatReportReason
  description    String?               @db.VarChar(200)
  status         MatchChatReportStatus @default(OPEN)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt     DateTime?             @map("resolved_at") @db.Timestamptz(6)

  message  MatchChatMessage             @relation(fields: [messageId], references: [id], onDelete: Restrict)
  reporter User                         @relation("MatchChatReportReporter", fields: [reporterUserId], references: [id], onDelete: Restrict)
  actions  MatchChatModerationAction[]

  @@unique([messageId, reporterUserId])
  @@index([status, createdAt])
  @@map("match_chat_reports")
}

model MatchChatModerationAction {
  id             String                        @id @default(uuid()) @db.Uuid
  reportId       String                        @map("report_id") @db.Uuid
  reviewerUserId String                        @map("reviewer_user_id") @db.Uuid
  action         MatchChatModerationActionType
  reason         String?                       @db.VarChar(200)
  createdAt      DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)

  report   MatchChatReport @relation(fields: [reportId], references: [id], onDelete: Restrict)
  reviewer User            @relation("MatchChatModerationReviewer", fields: [reviewerUserId], references: [id], onDelete: Restrict)

  @@index([reportId, createdAt])
  @@index([reviewerUserId, createdAt(sort: Desc)])
  @@map("match_chat_moderation_actions")
}

model CourtOperatorApplication {
  id                             String                     @id @default(uuid()) @db.Uuid
  applicantUserId                String                     @map("applicant_user_id") @db.Uuid
  status                         OperatorApplicationStatus  @default(DRAFT)
  businessName                   String                     @map("business_name") @db.VarChar(100)
  businessRegistrationNumberHash String                     @map("business_registration_number_hash") @db.VarChar(128)
  businessRegistrationCertificateUploadId String?           @unique @map("business_registration_certificate_upload_id") @db.Uuid
  verificationInputRef           String?                    @map("verification_input_ref") @db.VarChar(255)
  businessVerificationStatus     BusinessVerificationStatus @default(PENDING) @map("business_verification_status")
  venueVerificationStatus        VenueVerificationStatus    @default(PENDING) @map("venue_verification_status")
  venueName                      String                     @map("venue_name") @db.VarChar(100)
  venueAddress                   String                     @map("venue_address") @db.VarChar(255)
  normalizedVenueKey             String                     @map("normalized_venue_key") @db.VarChar(255)
  verificationFailureCode        String?                    @map("verification_failure_code") @db.VarChar(60)
  submittedAt                    DateTime?                  @map("submitted_at") @db.Timestamptz(6)
  verifiedAt                     DateTime?                  @map("verified_at") @db.Timestamptz(6)
  publishApprovedAt              DateTime?                  @map("publish_approved_at") @db.Timestamptz(6)
  createdAt                      DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                      DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)

  applicant            User                                     @relation("OperatorApplicationApplicant", fields: [applicantUserId], references: [id], onDelete: Restrict)
  businessRegistrationCertificate OperatorApplicationEvidenceUpload? @relation("BusinessRegistrationCertificate", fields: [businessRegistrationCertificateUploadId], references: [id], onDelete: Restrict)
  verificationAttempts OperatorApplicationVerificationAttempt[]
  reviews              OperatorApplicationReview[]
  court                Court?
  supplyRestrictions   OperatorSupplyRestriction[]

  @@index([applicantUserId, createdAt(sort: Desc)])
  @@index([businessRegistrationNumberHash, status])
  @@index([normalizedVenueKey, status])
  @@map("court_operator_applications")
}

model OperatorApplicationEvidenceUpload {
  id               String                                 @id @default(uuid()) @db.Uuid
  ownerUserId      String                                 @map("owner_user_id") @db.Uuid
  privateObjectRef String                                 @unique @map("private_object_ref") @db.VarChar(500)
  contentType      String                                 @map("content_type") @db.VarChar(100)
  byteSize         Int                                    @map("byte_size")
  status           OperatorApplicationEvidenceUploadStatus @default(PENDING)
  attachedAt       DateTime?                              @map("attached_at") @db.Timestamptz(6)
  expiresAt        DateTime?                              @map("expires_at") @db.Timestamptz(6)
  cleanupClaimedAt DateTime?                              @map("cleanup_claimed_at") @db.Timestamptz(6)
  deletedAt        DateTime?                              @map("deleted_at") @db.Timestamptz(6)
  createdAt        DateTime                               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                               @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner               User                     @relation("OperatorApplicationEvidenceUploadOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  attachedApplication CourtOperatorApplication? @relation("BusinessRegistrationCertificate")

  @@index([ownerUserId, status, createdAt])
  @@index([status, expiresAt])
  @@map("operator_application_evidence_uploads")
}

model OperatorApplicationReview {
  id             String                               @id @default(uuid()) @db.Uuid
  applicationId  String                               @map("application_id") @db.Uuid
  reviewerUserId String                               @map("reviewer_user_id") @db.Uuid
  decision       OperatorApplicationReviewDecision
  reasonCode     OperatorApplicationReviewReasonCode  @map("reason_code")
  createdAt      DateTime                             @default(now()) @map("created_at") @db.Timestamptz(6)

  application CourtOperatorApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  reviewer    User                     @relation("OperatorApplicationReviewer", fields: [reviewerUserId], references: [id], onDelete: Restrict)

  @@index([applicationId, createdAt])
  @@index([reviewerUserId, createdAt(sort: Desc)])
  @@map("operator_application_reviews")
}

model Court {
  id                    String   @id @default(uuid()) @db.Uuid
  operatorApplicationId String   @unique @map("operator_application_id") @db.Uuid
  regionCode            String   @map("region_code") @db.VarChar(30)
  name                  String   @db.VarChar(100)
  address               String   @db.VarChar(255)
  normalizedVenueKey    String   @unique @map("normalized_venue_key") @db.VarChar(255)
  status                CourtStatus @default(ACTIVE)
  deactivatedAt         DateTime? @map("deactivated_at") @db.Timestamptz(6)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  operatorApplication CourtOperatorApplication @relation(fields: [operatorApplicationId], references: [id], onDelete: Restrict)
  region              Region                   @relation(fields: [regionCode], references: [code], onDelete: Restrict)
  units               CourtUnit[]
  images              CourtImage[]
  statusChanges       CourtStatusChange[]

  @@index([regionCode, createdAt])
  @@map("courts")
}

model CourtStatusChange {
  id             String                               @id @default(uuid()) @db.Uuid
  courtId        String                               @map("court_id") @db.Uuid
  reviewerUserId String                               @map("reviewer_user_id") @db.Uuid
  fromStatus     CourtStatus                          @map("from_status")
  toStatus       CourtStatus                          @map("to_status")
  reasonCode     OperatorApplicationReviewReasonCode  @map("reason_code")
  createdAt      DateTime                             @default(now()) @map("created_at") @db.Timestamptz(6)

  court    Court @relation(fields: [courtId], references: [id], onDelete: Restrict)
  reviewer User  @relation("CourtStatusChangeReviewer", fields: [reviewerUserId], references: [id], onDelete: Restrict)

  @@index([courtId, createdAt])
  @@index([reviewerUserId, createdAt(sort: Desc)])
  @@map("court_status_changes")
}

model CourtImage {
  id               String           @id @default(uuid()) @db.Uuid
  courtId          String           @map("court_id") @db.Uuid
  ownerUserId      String           @map("owner_user_id") @db.Uuid
  privateObjectRef String           @unique @map("private_object_ref") @db.VarChar(500)
  contentType      String           @map("content_type") @db.VarChar(100)
  byteSize         Int              @map("byte_size")
  status           CourtImageStatus @default(PENDING)
  sortOrder        Int              @default(0) @map("sort_order")
  isRepresentative Boolean          @default(false) @map("is_representative")
  attachedAt       DateTime?        @map("attached_at") @db.Timestamptz(6)
  expiresAt        DateTime?        @map("expires_at") @db.Timestamptz(6)
  cleanupClaimedAt DateTime?        @map("cleanup_claimed_at") @db.Timestamptz(6)
  deletedAt        DateTime?        @map("deleted_at") @db.Timestamptz(6)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  court Court @relation(fields: [courtId], references: [id], onDelete: Restrict)
  owner User  @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)

  @@index([courtId, status, sortOrder])
  @@index([ownerUserId, status, createdAt])
  @@index([status, expiresAt])
  @@map("court_images")
}

model CourtUnit {
  id        String   @id @default(uuid()) @db.Uuid
  courtId   String   @map("court_id") @db.Uuid
  name      String   @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  court Court       @relation(fields: [courtId], references: [id], onDelete: Restrict)
  slots CourtSlot[]

  @@unique([courtId, name])
  @@index([courtId])
  @@map("court_units")
}

model CourtSlot {
  id                  String              @id @default(uuid()) @db.Uuid
  courtUnitId         String              @map("court_unit_id") @db.Uuid
  startsAt            DateTime            @map("starts_at") @db.Timestamptz(6)
  endsAt              DateTime            @map("ends_at") @db.Timestamptz(6)
  priceKrw            Int                 @map("price_krw")
  maxParticipantCount Int                 @map("max_participant_count")
  visibility          CourtSlotVisibility @default(PRIVATE)
  status              CourtSlotStatus     @default(DRAFT)
  publishedAt         DateTime?           @map("published_at") @db.Timestamptz(6)
  statusChangedAt     DateTime            @default(now()) @map("status_changed_at") @db.Timestamptz(6)
  usageNote           String?             @map("usage_note") @db.VarChar(500)
  version             Int                 @default(1)
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  courtUnit      CourtUnit               @relation(fields: [courtUnitId], references: [id], onDelete: Restrict)
  match          Match?
  statusHistory  CourtSlotStatusHistory[]
  supplyIncidents CourtSupplyIncident[]

  @@index([courtUnitId, startsAt])
  @@index([visibility, status, startsAt])
  @@map("court_slots")
}

model CourtSlotStatusHistory {
  id          String                @id @default(uuid()) @db.Uuid
  courtSlotId String                @map("court_slot_id") @db.Uuid
  fromStatus  CourtSlotStatus?      @map("from_status")
  toStatus    CourtSlotStatus       @map("to_status")
  actor       SlotStatusChangeActor
  actorUserId String?               @map("actor_user_id") @db.Uuid
  reasonCode  String                @map("reason_code") @db.VarChar(60)
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  courtSlot CourtSlot @relation(fields: [courtSlotId], references: [id], onDelete: Cascade)
  actorUser User?     @relation("CourtSlotStatusActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([courtSlotId, createdAt])
  @@map("court_slot_status_histories")
}

model CourtSupplyIncident {
  id                    String                    @id @default(uuid()) @db.Uuid
  courtSlotId           String                    @map("court_slot_id") @db.Uuid
  matchId               String                    @map("match_id") @db.Uuid
  code                  CourtSupplyIncidentCode
  impact                CourtSupplyIncidentImpact
  status                CourtSupplyIncidentStatus @default(REQUESTED)
  operatorAttributable  Boolean                   @default(false) @map("operator_attributable")
  publicNoticeCode      String                    @map("public_notice_code") @db.VarChar(60)
  reportedAt            DateTime                  @default(now()) @map("reported_at") @db.Timestamptz(6)
  withdrawnAt           DateTime?                 @map("withdrawn_at") @db.Timestamptz(6)
  reviewedAt            DateTime?                 @map("reviewed_at") @db.Timestamptz(6)
  createdAt             DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  courtSlot CourtSlot                    @relation(fields: [courtSlotId], references: [id], onDelete: Restrict)
  match     Match                        @relation(fields: [matchId], references: [id], onDelete: Restrict)
  recipients MatchSupplyNoticeRecipient[]

  @@index([courtSlotId, createdAt])
  @@index([matchId, status])
  @@map("court_supply_incidents")
}

model MatchSupplyNoticeRecipient {
  id              String              @id @default(uuid()) @db.Uuid
  incidentId      String              @map("incident_id") @db.Uuid
  matchId         String              @map("match_id") @db.Uuid
  recipientUserId String              @map("recipient_user_id") @db.Uuid
  noticeCode      String              @map("notice_code") @db.VarChar(60)
  deliveredAt     DateTime            @default(now()) @map("delivered_at") @db.Timestamptz(6)

  incident      CourtSupplyIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  match         Match               @relation(fields: [matchId], references: [id], onDelete: Cascade)
  recipientUser User                @relation("MatchSupplyNoticeRecipientUser", fields: [recipientUserId], references: [id], onDelete: Restrict)

  @@unique([incidentId, recipientUserId])
  @@index([recipientUserId, deliveredAt(sort: Desc)])
  @@index([matchId, deliveredAt(sort: Desc)])
  @@map("match_supply_notice_recipients")
}

model OperatorSupplyRestriction {
  id                    String                           @id @default(uuid()) @db.Uuid
  operatorApplicationId String                           @map("operator_application_id") @db.Uuid
  source                OperatorSupplyRestrictionSource @default(AUTOMATED)
  reasonCode            String                           @map("reason_code") @db.VarChar(60)
  triggeredAt           DateTime                         @default(now()) @map("triggered_at") @db.Timestamptz(6)
  clearedAt             DateTime?                        @map("cleared_at") @db.Timestamptz(6)
  clearedByUserId       String?                          @map("cleared_by_user_id") @db.Uuid
  createdAt             DateTime                         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                         @updatedAt @map("updated_at") @db.Timestamptz(6)

  operatorApplication CourtOperatorApplication @relation(fields: [operatorApplicationId], references: [id], onDelete: Restrict)
  clearedByUser       User?                    @relation("OperatorSupplyRestrictionClearedBy", fields: [clearedByUserId], references: [id], onDelete: Restrict)

  @@index([operatorApplicationId, clearedAt])
  @@map("operator_supply_restrictions")
}

model OperatorApplicationVerificationAttempt {
  id                 String                    @id @default(uuid()) @db.Uuid
  applicationId      String                    @map("application_id") @db.Uuid
  kind               VerificationAttemptKind
  result             VerificationAttemptResult
  safeFailureCode    String?                   @map("safe_failure_code") @db.VarChar(60)
  providerRequestRef String?                   @map("provider_request_ref") @db.VarChar(120)
  attemptedAt        DateTime                  @default(now()) @map("attempted_at") @db.Timestamptz(6)

  application CourtOperatorApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, attemptedAt(sort: Desc)])
  @@map("operator_application_verification_attempts")
}
