}

model OperatorSupplyRestriction {
  id                    String                           @id @default(uuid()) @db.Uuid
  operatorApplicationId String                           @map("operator_application_id") @db.Uuid
  source                OperatorSupplyRestrictionSource @default(AUTOMATED)
  reasonCode            String                           @map("reason_code") @db.VarChar(60)
  triggeredAt           DateTime                         @default(now()) @map("triggered_at") @db.Timestamptz(6)
  clearedAt             DateTime?                        @map("cleared_at") @db.Timestamptz(6)
  clearedByUserId       String?                          @map("cleared_by_user_id") @db.Uuid
  createdAt             DateTime                         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                         @updatedAt @map("updated_at") @db.Timestamptz(6)

  operatorApplication CourtOperatorApplication @relation(fields: [operatorApplicationId], references: [id], onDelete: Restrict)
  clearedByUser       User?                    @relation("OperatorSupplyRestrictionClearedBy", fields: [clearedByUserId], references: [id], onDelete: Restrict)

  @@index([operatorApplicationId, clearedAt])
  @@map("operator_supply_restrictions")
}

model OperatorApplicationVerificationAttempt {
  id                 String                    @id @default(uuid()) @db.Uuid
  applicationId      String                    @map("application_id") @db.Uuid
  kind               VerificationAttemptKind
  result             VerificationAttemptResult
  safeFailureCode    String?                   @map("safe_failure_code") @db.VarChar(60)
  providerRequestRef String?                   @map("provider_request_ref") @db.VarChar(120)
  attemptedAt        DateTime                  @default(now()) @map("attempted_at") @db.Timestamptz(6)

  application CourtOperatorApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, attemptedAt(sort: Desc)])
  @@map("operator_application_verification_attempts")
}

// Original responsibility stays on Match.hostUserId; only residual work is assigned.
model CourtTransactionHandoff {
  id                String                         @id @default(uuid()) @db.Uuid
  matchId           String                         @unique @map("match_id") @db.Uuid
  assigneeUserId    String?                        @map("assignee_user_id") @db.Uuid
  version           Int                            @default(1)
  createdAt         DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  match             Match                          @relation(fields: [matchId], references: [id], onDelete: Restrict)
  assignee          User?                          @relation("CourtHandoffAssignee", fields: [assigneeUserId], references: [id], onDelete: Restrict)
  events            CourtTransactionHandoffEvent[]

  @@map("court_transaction_handoffs")
}

model CourtTransactionHandoffEvent {
  id                     String                  @id @default(uuid()) @db.Uuid
  handoffId              String                  @map("handoff_id") @db.Uuid
  actorUserId            String                  @map("actor_user_id") @db.Uuid
  previousAssigneeUserId String?                 @map("previous_assignee_user_id") @db.Uuid
  clientRequestId        String                  @map("client_request_id") @db.Uuid
  note                   String                  @db.VarChar(500)
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  handoff                CourtTransactionHandoff @relation(fields: [handoffId], references: [id], onDelete: Restrict)
  actor                  User                    @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([handoffId, clientRequestId])
  @@map("court_transaction_handoff_events")
}
