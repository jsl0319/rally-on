model CourtSlot {
  id                  String              @id @default(uuid()) @db.Uuid
  courtUnitId         String              @map("court_unit_id") @db.Uuid
  startsAt            DateTime            @map("starts_at") @db.Timestamptz(6)
  endsAt              DateTime            @map("ends_at") @db.Timestamptz(6)
  /// 게스트 한 명이 내는 고정 참가비. 코트 총액이 아니라서 인원으로 나누지 않는다.
  priceKrw            Int                 @map("price_krw")
  /// 참가자 정원. 운영자는 플레이어가 아니므로 이 수에 포함하지 않는다.
  maxParticipantCount Int                 @map("max_participant_count")
