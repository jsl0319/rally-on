generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  WITHDRAWN
}

enum UserRole {
  MEMBER
  INTERNAL_REVIEWER
}

enum ExperienceRange {
  UNDER_3_MONTHS
  MONTHS_3_TO_6
  MONTHS_6_TO_12
  YEARS_1_TO_2
  YEARS_2_PLUS
}

enum RallyLevel {
  STARTING
  SHORT_RALLY
  COMFORTABLE_RALLY
  STANDARD_RALLY
}

enum GameExperience {
  NONE
  KNOWS_RULES
  PLAYED_FEW
  CAN_PLAY
}

enum PlayPurpose {
  CASUAL_HIT
  RALLY_PRACTICE
  STROKE_PRACTICE
  GAME_INTRO
  GAME
}

enum RegionType {
  CITY
  DISTRICT
}

enum CourtSource {
  EXTERNAL_RESERVED
  COURT_TBD
  PARTNER_COURT
}

enum PartnerPreference {
  COMPLETE_BEGINNER_WELCOME
  SIMILAR_LEVEL
  GAME_CAPABLE
}

enum MatchStatus {
  OPEN
  CLOSED
  COMPLETED
  EXPIRED
  CANCELLED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
  CANCELLED
  /// 코트 매칭 전용. 운영자가 입금을 확인해 참가가 확정된 상태.
  CONFIRMED
  /// 코트 매칭 전용. 승인 뒤 입금 기한이 지나 자동 취소된 상태.
  EXPIRED_UNPAID
}

enum MatchConversationStatus {
  OPEN
  READ_ONLY
  ARCHIVED
}

enum MatchConversationMemberRole {
  HOST
  PARTICIPANT
}

enum MatchChatMessageType {
  USER
  SYSTEM
}

enum MatchChatMessageVisibility {
  VISIBLE
  HIDDEN
}

enum MatchChatImageUploadStatus {
  PENDING
  ATTACHED
  CLEANUP_PENDING
  DELETED
}

enum MatchChatReportReason {
  HARASSMENT
  SEXUAL_OR_HATEFUL_CONTENT
  PERSONAL_INFORMATION
  SPAM_OR_FRAUD
  OTHER
}

enum MatchChatReportStatus {
  OPEN
  RESOLVED
}

enum MatchChatModerationActionType {
  NO_ACTION
  HIDE_MESSAGE
  SUSPEND_SENDING
  SET_READ_ONLY
}

enum CourtImageUploadStatus {
  PENDING
  ATTACHED
  CLEANUP_PENDING
  DELETED
}

enum CourtImageStatus {
  PENDING
  ATTACHED
  REPLACED
  CLEANUP_PENDING
  DELETED
}

enum CourtStatus {
  ACTIVE
  INACTIVE
}

enum CourtSlotVisibility {
  PRIVATE
  PUBLIC
}

enum CourtSlotStatus {
  DRAFT
  AVAILABLE
  ALLOCATED
  ENDED
  BLOCKED
  CANCELLED
}

/// 코트 매칭의 참가 승인 방식. AUTO는 성별·경기 유형 조건만 서버가 검증하고
/// 사람 손을 거치지 않는다. OPERATOR는 운영자가 신청을 직접 검토한다.
enum CourtSlotApprovalMode {
  AUTO
  OPERATOR
}

enum SlotStatusChangeActor {
  OPERATOR
  SESSION_HOST
  SYSTEM
  ADMIN
}

enum CourtSupplyIncidentCode {
  SCHEDULE_UNAVAILABLE
  FACILITY_CLOSED
  SAFETY_RISK
  NATURAL_DISASTER
  INFORMATION_REVIEW
}

enum CourtSupplyIncidentImpact {
  NONE
  CANCEL_MATCH
}

enum CourtSupplyIncidentStatus {
  REQUESTED
  WITHDRAWN
  REVIEWED
  REJECTED
}

enum OperatorSupplyRestrictionSource {
  AUTOMATED
  ADMIN
}

enum OperatorApplicationStatus {
  DRAFT
  VERIFYING
  DRAFT_ACCESS_GRANTED
  REVIEW_REQUIRED
  UNDER_REVIEW
  CHANGES_REQUESTED
  PUBLISH_APPROVED
  REJECTED
  SUSPENDED
}

enum OperatorApplicationEvidenceUploadStatus {
  PENDING
  ATTACHED
  REPLACED
  CLEANUP_PENDING
  DELETED
}

enum OperatorApplicationReviewDecision {
  APPROVE_PUBLISH
  REQUEST_CHANGES
  REJECT
  SUSPEND_PUBLISH
}

enum OperatorApplicationReviewReasonCode {
  MANUAL_VERIFIED
  INFORMATION_INCOMPLETE
  BUSINESS_UNVERIFIED
  VENUE_UNVERIFIED
  OPERATING_AUTHORITY_UNCONFIRMED
  DUPLICATE_VENUE
  SAFETY_REVIEW
  VENUE_CLOSED
}

enum BusinessVerificationStatus {
  PENDING
  VERIFIED
  MISMATCH
  UNAVAILABLE
}

enum VenueVerificationStatus {
  PENDING
  MATCHED
  REVIEW_REQUIRED
  UNAVAILABLE
}

enum VerificationAttemptKind {
  BUSINESS
  VENUE
}

enum VerificationAttemptResult {
  VERIFIED
  MISMATCH
  UNAVAILABLE
  REVIEW_REQUIRED
  PENDING
}

model User {
  id                        String     @id @default(uuid()) @db.Uuid
  nickname                  String     @unique @db.VarChar(12)
  status                    UserStatus @default(ACTIVE)
  role                      UserRole   @default(MEMBER)
  nicknameConfirmedAt       DateTime?  @map("nickname_confirmed_at") @db.Timestamptz(6)
  onboardingCompletedAt     DateTime?  @map("onboarding_completed_at") @db.Timestamptz(6)
  withdrawnAt               DateTime?  @map("withdrawn_at") @db.Timestamptz(6)
  matchNotificationsEnabled Boolean    @default(true) @map("match_notifications_enabled")
  kakaoProfileImageUrl      String?    @map("kakao_profile_image_url") @db.VarChar(500)
  profileImageObjectRef     String?    @map("profile_image_object_ref") @db.VarChar(500)
  profileImageContentType   String?    @map("profile_image_content_type") @db.VarChar(40)
  profileImageUpdatedAt     DateTime?  @map("profile_image_updated_at") @db.Timestamptz(6)
  createdAt                 DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  authAccounts                       AuthAccount[]
  tennisProfile                      TennisProfile?
  apiRateLimit                       ApiRateLimit?
  hostedMatches                      Match[]                             @relation("MatchHost")
  matchApplications                  MatchApplication[]
  courtImageUploads                  CourtImageUpload[]
  courtImages                        CourtImage[]
  operatorApplications               CourtOperatorApplication[]          @relation("OperatorApplicationApplicant")
  operatorApplicationEvidenceUploads OperatorApplicationEvidenceUpload[] @relation("OperatorApplicationEvidenceUploadOwner")
  operatorApplicationReviews         OperatorApplicationReview[]         @relation("OperatorApplicationReviewer")
  courtStatusChanges                 CourtStatusChange[]                 @relation("CourtStatusChangeReviewer")
  courtSlotStatusHistories           CourtSlotStatusHistory[]            @relation("CourtSlotStatusActor")
  supplyNoticeRecipients             MatchSupplyNoticeRecipient[]        @relation("MatchSupplyNoticeRecipientUser")
  clearedSupplyRestrictions          OperatorSupplyRestriction[]         @relation("OperatorSupplyRestrictionClearedBy")
  matchConversationMemberships       MatchConversationMember[]
  sentMatchChatMessages              MatchChatMessage[]                  @relation("MatchChatMessageSender")
  matchChatImageUploads              MatchChatImageUpload[]              @relation("MatchChatImageUploadOwner")
  matchChatReports                   MatchChatReport[]                   @relation("MatchChatReportReporter")
  matchChatModerationActions         MatchChatModerationAction[]         @relation("MatchChatModerationReviewer")
  notifications                      Notification[]
  supportInquiries                   SupportInquiry[]                    @relation("SupportInquiryOwner")
  assignedSupportInquiries           SupportInquiry[]                    @relation("SupportInquiryAssignee")
  supportMessages                    SupportInquiryMessage[]
  courtReceiptRecords                CourtReceiptRecord[]
  courtRefundAttempts                CourtRefundAttempt[]
  courtRefundEvents                  CourtRefundEvent[]
  assignedCourtHandoffs CourtTransactionHandoff[] @relation("CourtHandoffAssignee")
  courtHandoffEvents CourtTransactionHandoffEvent[]
  courtCompositionCancellations CourtMatchCompositionCancellation[]

  @@map("users")
}

model AuthAccount {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  provider          String   @db.VarChar(30)
  providerAccountId String   @map("provider_account_id") @db.VarChar(191)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("auth_accounts")
}

enum ProfileGender {
  MALE
  FEMALE
}

model TennisProfile {
  gender              ProfileGender?
  id                  String          @id @default(uuid()) @db.Uuid
  userId              String          @unique @map("user_id") @db.Uuid
  experienceRange     ExperienceRange @map("experience_range")
  rallyLevel          RallyLevel      @map("rally_level")
  gameExperience      GameExperience  @map("game_experience")
  skillLabel          String?         @map("skill_label") @db.VarChar(30)
  version             Int             @default(1)
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  purposes TennisProfilePurpose[]

  @@map("tennis_profiles")
}

model Region {
  code       String     @id @db.VarChar(30)
  parentCode String?    @map("parent_code") @db.VarChar(30)
  name       String     @db.VarChar(50)
  shortName  String?    @map("short_name") @db.VarChar(30)
  type       RegionType
  active     Boolean    @default(true)

  parent   Region?  @relation("RegionHierarchy", fields: [parentCode], references: [code], onDelete: Restrict)
  children Region[] @relation("RegionHierarchy")
  courts   Court[]

  @@unique([parentCode, name])
  @@index([parentCode, active])
  @@map("regions")
}

model TennisProfilePurpose {
  tennisProfileId String      @map("tennis_profile_id") @db.Uuid
  purpose         PlayPurpose

  tennisProfile TennisProfile @relation(fields: [tennisProfileId], references: [id], onDelete: Cascade)

  @@id([tennisProfileId, purpose])
  @@map("tennis_profile_purposes")
}

model ApiRateLimit {
  userId          String   @id @map("user_id") @db.Uuid
  windowStartedAt DateTime @map("window_started_at") @db.Timestamptz(6)
  requestCount    Int      @default(0) @map("request_count")
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_rate_limits")
}

enum NotificationType {
  APPLICATION_RECEIVED
  APPLICATION_ACCEPTED
  APPLICATION_REJECTED
  /// --- 코트 매칭 계좌이체 흐름 ---
  COURT_MATCH_DEPOSIT_REQUIRED
  COURT_MATCH_DEPOSIT_CLAIMED
  COURT_MATCH_CONFIRMED
  COURT_MATCH_DEPOSIT_EXPIRED
  COURT_MATCH_CANCELLED
  COURT_MATCH_PARTICIPANT_CANCELLED
  COURT_MATCH_REFUND_COMPLETED
  /// --- 일반 매칭의 신청이 내 뜻과 무관하게 정리되는 경로 ---
  MATCH_CANCELLED
  MATCH_CLOSED
  MATCH_EXPIRED
  MATCH_PARTICIPANT_LEFT
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String           @db.VarChar(80)
  body      String           @db.VarChar(200)
  href      String?          @db.VarChar(255)
  readAt    DateTime?        @map("read_at") @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
  @@map("notifications")
}

model Announcement {
  id          String   @id @default(uuid()) @db.Uuid
  title       String   @db.VarChar(120)
  body        String   @db.VarChar(2000)
  publishedAt DateTime @default(now()) @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([publishedAt(sort: Desc)])
  @@map("announcements")
}

enum SupportInquiryStatus {
  OPEN
  IN_PROGRESS
  WAITING_OPERATOR
  ANSWERED
  RESOLVED
}

enum SupportMessageVisibility {
  PUBLIC
  OPERATOR
}

model SupportInquiry {
  id             String               @id @default(uuid()) @db.Uuid
  userId         String               @map("user_id") @db.Uuid
  /// 어느 매칭에 대한 문의인지. 코트 매칭의 입금·환불 문의는 건을 특정할 수 있어야
  /// 운영자에게 되묻지 않고 처리할 수 있다. 일반 문의는 비어 있다.
  matchId        String?              @map("match_id") @db.Uuid
  applicationId  String?              @map("application_id") @db.Uuid
  assigneeUserId String?              @map("assignee_user_id") @db.Uuid
  message        String               @db.VarChar(1000)
  status         SupportInquiryStatus @default(OPEN)
  version        Int                  @default(1)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user        User                    @relation("SupportInquiryOwner", fields: [userId], references: [id], onDelete: Restrict)
  assignee    User?                   @relation("SupportInquiryAssignee", fields: [assigneeUserId], references: [id], onDelete: Restrict)
  match       Match?                  @relation(fields: [matchId], references: [id], onDelete: Restrict)
  application MatchApplication?       @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  messages    SupportInquiryMessage[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([matchId, createdAt(sort: Desc)])
  @@index([status, updatedAt])
  @@map("support_inquiries")
}

model SupportInquiryMessage {
  id              String                   @id @default(uuid()) @db.Uuid
  inquiryId       String                   @map("inquiry_id") @db.Uuid
  authorUserId    String                   @map("author_user_id") @db.Uuid
  clientRequestId String                   @map("client_request_id") @db.Uuid
  action String @default("REPLY") @db.VarChar(32)
  previousAssigneeUserId String? @map("previous_assignee_user_id") @db.Uuid
  nextAssigneeUserId String? @map("next_assignee_user_id") @db.Uuid
  visibility      SupportMessageVisibility
  body            String                   @db.VarChar(2000)
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  inquiry         SupportInquiry           @relation(fields: [inquiryId], references: [id], onDelete: Restrict)
  author          User                     @relation(fields: [authorUserId], references: [id], onDelete: Restrict)

  @@unique([inquiryId, clientRequestId])
  @@index([inquiryId, createdAt])
  @@map("support_inquiry_messages")
}

enum MatchGameType {
  MIXED_DOUBLES
  MENS_DOUBLES
  WOMENS_DOUBLES
  SINGLES
  RALLY
  OTHER
}

model Match {
  id                   String            @id @default(uuid()) @db.Uuid
  hostUserId           String            @map("host_user_id") @db.Uuid
  clientRequestId      String            @map("client_request_id") @db.Uuid
  title                String            @db.VarChar(80)
  startsAt             DateTime          @map("starts_at") @db.Timestamptz(6)
  endsAt               DateTime          @map("ends_at") @db.Timestamptz(6)
  courtSource          CourtSource       @default(EXTERNAL_RESERVED) @map("court_source")
  externalCourtName    String?           @map("external_court_name") @db.VarChar(100)
  externalCourtAddress String?           @map("external_court_address") @db.VarChar(255)
  externalCourtNumber  String?           @map("external_court_number") @db.VarChar(50)
  externalCourtImageUploadId String?     @unique @map("external_court_image_upload_id") @db.Uuid
  courtSlotId            String?           @unique @map("court_slot_id") @db.Uuid
  recruitCount         Int               @map("recruit_count")
  partnerPreference    PartnerPreference @map("partner_preference")
  totalCourtFeeKrw     Int?              @map("total_court_fee_krw")
  additionalCostNote   String?           @map("additional_cost_note") @db.VarChar(200)
  introduction         String?           @db.VarChar(300)
  maleRecruitCount     Int?              @map("male_recruit_count")
  femaleRecruitCount   Int?              @map("female_recruit_count")
  gameType             MatchGameType?    @map("game_type")
  /// 0 preserves previously published matches; 1 validates the advertised game composition.
  courtCompositionPolicyVersion Int @default(0) @map("court_composition_policy_version")
  courtCompositionPassedAt DateTime? @map("court_composition_passed_at") @db.Timestamptz(6)
  courtCompositionSnapshot Json? @map("court_composition_snapshot") @db.JsonB
  settlementBank       String?           @map("settlement_bank") @db.VarChar(50)
  settlementAccountNumber String?        @map("settlement_account_number") @db.VarChar(40)
  settlementAccountHolder String?        @map("settlement_account_holder") @db.VarChar(50)
  status               MatchStatus       @default(OPEN)
  version              Int               @default(1)
  closedAt             DateTime?         @map("closed_at") @db.Timestamptz(6)
  completedAt          DateTime?         @map("completed_at") @db.Timestamptz(6)
  expiredAt            DateTime?         @map("expired_at") @db.Timestamptz(6)
  cancelledAt          DateTime?         @map("cancelled_at") @db.Timestamptz(6)
  cancellationReason   String?           @map("cancellation_reason") @db.VarChar(200)
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  host         User               @relation("MatchHost", fields: [hostUserId], references: [id], onDelete: Restrict)
  purposes     MatchPurpose[]
  applications MatchApplication[]
  externalCourtImageUpload CourtImageUpload? @relation("ExternalCourtImage", fields: [externalCourtImageUploadId], references: [id], onDelete: Restrict)
  courtSlot    CourtSlot?          @relation(fields: [courtSlotId], references: [id], onDelete: Restrict)
  supplyIncidents CourtSupplyIncident[]
  supplyNoticeRecipients MatchSupplyNoticeRecipient[]
  conversation MatchConversation?
  supportInquiries SupportInquiry[]
  transactionHandoff CourtTransactionHandoff?
  compositionCancellation CourtMatchCompositionCancellation?

  @@unique([hostUserId, clientRequestId])
  @@index([status, startsAt])
  @@index([hostUserId, status, startsAt])
  @@map("matches")
}

model CourtMatchCompositionCancellation {
  id String @id @default(uuid()) @db.Uuid
  matchId String @unique @map("match_id") @db.Uuid
  actorUserId String @map("actor_user_id") @db.Uuid
  clientRequestId String @map("client_request_id") @db.Uuid
  note String @db.VarChar(500)
  compositionSnapshot Json @map("composition_snapshot") @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  match Match @relation(fields: [matchId], references: [id], onDelete: Restrict)
  actor User @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@map("court_match_composition_cancellations")
}

model CourtImageUpload {
  id               String                 @id @default(uuid()) @db.Uuid
  ownerUserId      String                 @map("owner_user_id") @db.Uuid
  privateObjectRef String                 @unique @map("private_object_ref") @db.VarChar(500)
  contentType      String                 @map("content_type") @db.VarChar(100)
  byteSize         Int                    @map("byte_size")
  status           CourtImageUploadStatus @default(PENDING)
  attachedAt       DateTime?              @map("attached_at") @db.Timestamptz(6)
  cleanupClaimedAt DateTime?              @map("cleanup_claimed_at") @db.Timestamptz(6)
  deletedAt        DateTime?              @map("deleted_at") @db.Timestamptz(6)
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner         User   @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  attachedMatch Match? @relation("ExternalCourtImage")

  @@index([ownerUserId, status, createdAt])
  @@index([status, createdAt])
  @@map("court_image_uploads")
}

model MatchPurpose {
  matchId String      @map("match_id") @db.Uuid
  purpose PlayPurpose

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@id([matchId, purpose])
  @@index([purpose, matchId])
  @@map("match_purposes")
}

model MatchApplication {
  applicantGender        ProfileGender?    @map("applicant_gender")
  id                     String            @id @default(uuid()) @db.Uuid
  matchId                String            @map("match_id") @db.Uuid
  applicantUserId        String            @map("applicant_user_id") @db.Uuid
  status                 ApplicationStatus @default(PENDING)
  message                String?           @db.VarChar(200)
  profileSnapshot        Json              @map("profile_snapshot") @db.JsonB
  profileSnapshotVersion Int               @default(1) @map("profile_snapshot_version")
  courtNoticeVersion     String?           @map("court_notice_version") @db.VarChar(64)
  courtNoticeSnapshot    Json?             @map("court_notice_snapshot") @db.JsonB
  courtNoticeAcceptedAt  DateTime?         @map("court_notice_accepted_at") @db.Timestamptz(6)
  decidedAt              DateTime?         @map("decided_at") @db.Timestamptz(6)
  withdrawnAt            DateTime?         @map("withdrawn_at") @db.Timestamptz(6)
  cancelledAt            DateTime?         @map("cancelled_at") @db.Timestamptz(6)
  /// --- 코트 매칭 계좌이체 흐름 ---
  /// 입금자명 뒤에 붙여 통장 내역과 대조하는 식별코드. 승인 시 서버가 만든다.
  depositCode            String?           @map("deposit_code") @db.VarChar(8)
  /// 승인 시 걸리는 입금 기한. 지나면 자동으로 EXPIRED_UNPAID가 된다.
  paymentDueAt           DateTime?         @map("payment_due_at") @db.Timestamptz(6)
  confirmationDueAt      DateTime?         @map("confirmation_due_at") @db.Timestamptz(6)
  /// null은 실제 수령액을 별도로 기록하기 전의 신청이다.
  feeReceivedAt DateTime? @map("fee_received_at") @db.Timestamptz(6)
  receivedAmountKrw      Int?              @map("received_amount_krw")
  lastReceivedAt         DateTime?         @map("last_received_at") @db.Timestamptz(6)
  receiptVersion         Int               @default(0) @map("receipt_version")
  /// 참가자가 실제로 보낸 입금자명과 알린 시각.
  depositorName          String?           @map("depositor_name") @db.VarChar(50)
  depositClaimedAt       DateTime?         @map("deposit_claimed_at") @db.Timestamptz(6)
  confirmedAt            DateTime?         @map("confirmed_at") @db.Timestamptz(6)
  /// 환불받을 계좌. 취소가 실제로 일어난 뒤에만 참가자에게 받는다.
  refundBank             String?           @map("refund_bank") @db.VarChar(50)
  refundAccountNumber    String?           @map("refund_account_number") @db.VarChar(40)
  refundAccountHolder    String?           @map("refund_account_holder") @db.VarChar(50)
  refundRequestedAt      DateTime?         @map("refund_requested_at") @db.Timestamptz(6)
  refundAccountVersion   Int               @default(1) @map("refund_account_version")
  /// 새 송금 이력 도입 전 완료 표시는 금액을 고정해 따로 보존한다.
  legacyRefundPaidKrw    Int               @default(0) @map("legacy_refund_paid_krw")
  /// 참가자가 스스로 참가를 취소한 시각. 운영자 철회·최소 인원 미달 취소와 구분한다.
  participantCancelledAt DateTime?         @map("participant_cancelled_at") @db.Timestamptz(6)
  /// 취소 시점에 확정한 환불 금액. 취소 시각과 참가비로 계산해 스냅샷으로 남긴다.
  /// null은 이 열이 생기기 전의 기록이거나 앱 사유 취소로, 전액 환불을 뜻한다.
  refundAmountKrw        Int?              @map("refund_amount_krw")
  /// 운영자가 환불했다고 표시한 시각. 서비스가 송금을 확인한 것은 아니다.
  refundCompletedAt      DateTime?         @map("refund_completed_at") @db.Timestamptz(6)
  createdAt              DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  match            Match                @relation(fields: [matchId], references: [id], onDelete: Restrict)
  applicantUser    User                 @relation(fields: [applicantUserId], references: [id], onDelete: Restrict)
  receiptRecords   CourtReceiptRecord[]
  refundAttempts   CourtRefundAttempt[]
  supportInquiries SupportInquiry[]

  @@unique([matchId, applicantUserId])
  @@unique([matchId, depositCode])
  @@index([matchId, status, createdAt])
  @@index([applicantUserId, status, createdAt(sort: Desc)])
  @@map("match_applications")
}

