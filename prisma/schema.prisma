  minParticipantCount Int                 @default(2) @map("min_participant_count")
  gameType            MatchGameType?      @map("game_type")
  /// 복식이면 남녀 정원의 합이 maxParticipantCount와 같아야 한다.
  maleCapacity        Int?                @map("male_capacity")
  femaleCapacity      Int?                @map("female_capacity")
  approvalMode        CourtSlotApprovalMode @default(AUTO) @map("approval_mode")
  visibility          CourtSlotVisibility @default(PRIVATE)
  status              CourtSlotStatus     @default(DRAFT)
  publishedAt         DateTime?           @map("published_at") @db.Timestamptz(6)
  statusChangedAt     DateTime            @default(now()) @map("status_changed_at") @db.Timestamptz(6)
  usageNote           String?             @map("usage_note") @db.VarChar(500)
  version             Int                 @default(1)
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  courtUnit      CourtUnit               @relation(fields: [courtUnitId], references: [id], onDelete: Restrict)
  match          Match?
  statusHistory  CourtSlotStatusHistory[]
  supplyIncidents CourtSupplyIncident[]

  @@index([courtUnitId, startsAt])
  @@index([visibility, status, startsAt])
  @@map("court_slots")
}

